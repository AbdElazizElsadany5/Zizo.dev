# ===================================================
#  AbdElaziz's Portfolio Environment Configuration
# ===================================================

# Server Port (Default is 3000)
PORT=3000

# Admin Dashboard Password (Default is zizo123)
ADMIN_PASSWORD=zizo123

# MongoDB Atlas Database URI (Optional - If omitted, uses local JSON data files)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/zizo_portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Storage Configuration (Optional - For uploading images directly to Cloudinary)
# Method 1: Using CLOUDINARY_URL
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Method 2: Using discrete credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
